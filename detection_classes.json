{
  "name": "VisionTrack AI detection settings",
  "model": "coco-ssd (80 COCO classes)",
  "note": "This file chooses WHICH of the model's known classes are watched and how they are grouped. It cannot teach the model new objects.",
  "minScore": 0.6,
  "cooldownSeconds": 3,
  "defaultGroups": ["People", "Phones and electronics", "Bags", "Everyday items"],
  "groups": {
    "People": ["person"],
    "Phones and electronics": ["cell phone", "laptop", "tv", "keyboard", "mouse", "remote"],
    "Bags": ["backpack", "handbag", "suitcase"],
    "Everyday items": ["bottle", "cup", "book", "chair", "clock", "scissors"],
    "Vehicles": ["bicycle", "car", "motorcycle", "bus", "truck"],
    "Animals": ["cat", "dog", "bird"]
  }
}
